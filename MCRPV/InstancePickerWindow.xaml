<Window x:Class="Mcrpv.InstancePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Mcrpv"
        Title="{loc:Tr inst.title}" Height="500" Width="900"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" ShowInTaskbar="False">

    <ContentControl Style="{StaticResource McPanel}" Margin="14" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ContentControl Grid.Row="0" Style="{StaticResource McHeader}" Padding="10,5" Margin="0,0,0,8">
                <Grid>
                    <TextBlock Text="{loc:Tr inst.header}" Style="{StaticResource McHeaderText}"/>
                    <TextBlock Text="{loc:Tr inst.hint}" FontSize="9.5" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                </Grid>
            </ContentControl>

            <TextBlock x:Name="StatusText" Grid.Row="1" Margin="1,0,0,8"
                       Foreground="{DynamicResource TextSecondary}" FontSize="10.5" TextWrapping="Wrap"
                       Text="{loc:Tr inst.searching}"/>

            <ContentControl Grid.Row="2" Style="{StaticResource McScreen}">
                <ListView x:Name="InstanceList" Background="Transparent" BorderThickness="0"
                          Foreground="{DynamicResource ScreenText}" Padding="6"
                          MouseDoubleClick="InstanceList_MouseDoubleClick"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Instance" Width="250" DisplayMemberBinding="{Binding Instance}"/>
                            <GridViewColumn Header="{loc:Tr inst.col.modified}" Width="150" DisplayMemberBinding="{Binding ModifiedText}"/>
                            <GridViewColumn Header="{loc:Tr inst.col.file}" Width="400" DisplayMemberBinding="{Binding FileName}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </ContentControl>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="RefreshButton" Content="{loc:Tr inst.research}" Width="185" Height="34"
                        Margin="0,0,8,0" Style="{StaticResource McButtonSteel}"
                        Click="Refresh_Click" ToolTip="{loc:Tr inst.research.tip}"/>

                <Button x:Name="UseButton" Content="{loc:Tr inst.use}" Width="140" Height="34"
                        Margin="0,0,8,0" IsDefault="True"
                        Style="{StaticResource McButtonPrimary}" Click="Use_Click"/>

                <Button Content="{loc:Tr inst.cancel}" Width="130" Height="34" IsCancel="True"
                        Style="{StaticResource McButtonSteel}"/>
            </StackPanel>
        </Grid>
    </ContentControl>
</Window>
