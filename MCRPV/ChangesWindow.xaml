<Window x:Class="Mcrpv.ChangesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Mcrpv"
        Title="{loc:Tr changes.title}" Height="640" Width="1000"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" ShowInTaskbar="False">

    <ContentControl Style="{StaticResource McPanel}" Margin="14" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ContentControl Grid.Row="0" Style="{StaticResource McHeader}" Padding="10,5" Margin="0,0,0,8">
                <Grid>
                    <TextBlock Text="{loc:Tr changes.header}" Style="{StaticResource McHeaderText}"/>
                    <TextBlock x:Name="PackCaption" FontSize="9.5" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                </Grid>
            </ContentControl>

            <TextBlock x:Name="SummaryText" Grid.Row="1" Margin="1,0,0,8" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}" FontSize="10.5"
                       Text="{loc:Tr changes.comparing}"/>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="🔎 FILTER" Style="{StaticResource McLabel}"
                               VerticalAlignment="Center" Margin="1,0,8,0"/>

                    <TextBox x:Name="FilterBox" Grid.Column="1" Height="28" FontSize="11.5"
                             Style="{StaticResource McTextBox}" TextChanged="FilterBox_TextChanged"
                             ToolTip="{loc:Tr changes.filter.tip}"/>

                    <ComboBox x:Name="KindBox" Grid.Column="2" Width="150" Height="28" Margin="8,0,0,0"
                              SelectionChanged="KindBox_SelectionChanged"
                              ToolTip="{loc:Tr changes.kind.tip}">
                        <ComboBoxItem Content="{loc:Tr changes.kind.all}" IsSelected="True"/>
                        <ComboBoxItem Content="{loc:Tr changes.kind.new}"/>
                        <ComboBoxItem Content="{loc:Tr changes.kind.removed}"/>
                        <ComboBoxItem Content="{loc:Tr changes.kind.changed}"/>
                    </ComboBox>

                    <TextBlock x:Name="CountText" Grid.Column="3" Margin="10,0,0,0" VerticalAlignment="Center"
                               FontSize="10.5" Foreground="{DynamicResource TextSecondary}" Text=""/>
                </Grid>

                <ContentControl Grid.Row="1" Style="{StaticResource McScreen}">
                    <ListBox x:Name="DiffList" Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource ScreenText}" FontFamily="Consolas" FontSize="11"
                             DisplayMemberPath="Label" MouseDoubleClick="DiffList_MouseDoubleClick"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ToolTip="{loc:Tr changes.list.tip}"/>
                </ContentControl>
            </Grid>

            <WrapPanel Grid.Row="3" Margin="0,8,0,10">
                <Button x:Name="ReindexButton" Content="{loc:Tr changes.reindex}" Width="300" Height="32"
                        Margin="0,0,8,0" Style="{StaticResource McButtonPrimary}" Click="Reindex_Click"
                        ToolTip="{loc:Tr changes.reindex.tip}"/>
                <Button x:Name="LoadFoldButton" Content="{loc:Tr changes.loadfold}" Width="240" Height="32"
                        Margin="0,0,8,0" Style="{StaticResource McButtonSteel}" Click="LoadFold_Click"
                        ToolTip="{loc:Tr changes.loadfold.tip}"/>
                <Button x:Name="SaveFoldButton" Content="{loc:Tr changes.savefold}" Width="260" Height="32"
                        Style="{StaticResource McButtonSuccess}" Click="SaveFold_Click"
                        ToolTip="{loc:Tr changes.savefold.tip}"/>
                <Button x:Name="UsePlainButton" Content="{loc:Tr changes.useplain}" Width="270" Height="32"
                        Margin="0,8,0,0" Style="{StaticResource McButtonSteel}" Click="UsePlain_Click"
                        ToolTip="{loc:Tr changes.useplain.tip}"/>
                <Button x:Name="DeadPatchesButton" Content="{loc:Tr changes.dead}" Width="210" Height="32"
                        Margin="8,8,0,0" Style="{StaticResource McButtonSteel}" Click="DeadPatches_Click"
                        ToolTip="{loc:Tr changes.dead.tip}"/>
            </WrapPanel>

            <ContentControl Grid.Row="4" Style="{StaticResource McHeader}" Padding="10,5" Margin="0,0,0,8">
                <TextBlock Text="📦 PACKS" Style="{StaticResource McHeaderText}"/>
            </ContentControl>

            <Grid Grid.Row="5" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="PackCombo" Grid.Column="0" Height="30" FontSize="11.5"
                          DisplayMemberPath="Label" SelectionChanged="PackCombo_SelectionChanged"/>

                <Button x:Name="UsePackButton" Grid.Column="1" Content="{loc:Tr changes.activate}" Width="160" Height="30"
                        Margin="8,0,0,0" Style="{StaticResource McButtonSteel}" Click="UsePack_Click"
                        ToolTip="{loc:Tr changes.activate.tip}"/>

                <Button x:Name="RefreshButton" Grid.Column="2" Content="{loc:Tr changes.refresh}" Width="120" Height="30"
                        Margin="8,0,0,0" Style="{StaticResource McButtonSteel}" Click="Refresh_Click"/>
            </Grid>

            <TextBlock x:Name="PackInfoText" Grid.Row="6" TextWrapping="Wrap" FontSize="10.5"
                       Foreground="{DynamicResource TextSecondary}"
                       Text="{loc:Tr changes.noprofiles}"/>

            <TextBlock Grid.Row="7" Margin="0,10,0,0" FontSize="9.5" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Text="{loc:Tr changes.footer}"/>
        </Grid>
    </ContentControl>
</Window>
