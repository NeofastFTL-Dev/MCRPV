<Window x:Class="Mcrpv.ProvenanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Mcrpv"
        Title="{loc:Tr prov.title}" Height="520" Width="920"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" ShowInTaskbar="False">

    <ContentControl Style="{StaticResource McPanel}" Margin="14" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ContentControl Grid.Row="0" Style="{StaticResource McHeader}" Padding="10,5" Margin="0,0,0,8">
                <TextBlock Text="{loc:Tr prov.header}" Style="{StaticResource McHeaderText}"/>
            </ContentControl>

            <Grid Grid.Row="1" Margin="1,0,0,6">
                <TextBlock x:Name="ItemText" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}" Text="item"/>
                <TextBlock x:Name="LayerText" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="11" Foreground="{DynamicResource Accent}" Text=""/>
            </Grid>

            <TextBlock x:Name="DetailsText" Grid.Row="2" Margin="1,0,0,2" FontSize="11"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Text=""/>

            <TextBlock x:Name="SourceText" Grid.Row="3" Margin="1,0,0,8" FontSize="10.5"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Text=""/>

            <ContentControl Grid.Row="4" Style="{StaticResource McScreen}">
                <ListBox x:Name="Lines" Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource ScreenText}" FontFamily="Consolas" FontSize="11.5"
                         DisplayMemberPath="Text" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
            </ContentControl>

            <TextBlock Grid.Row="5" Margin="1,8,0,0" FontSize="9.5" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Text="{loc:Tr prov.footer}"/>
        </Grid>
    </ContentControl>
</Window>
