<Window x:Class="Mcrpv.ModsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Mcrpv"
        Title="{loc:Tr mods.title}" Height="620" Width="1000"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" ShowInTaskbar="False">

    <ContentControl Style="{StaticResource McPanel}" Margin="14" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ContentControl Grid.Row="0" Style="{StaticResource McHeader}" Padding="10,5" Margin="0,0,0,8">
                <Grid>
                    <TextBlock Text="{loc:Tr mods.header}" Style="{StaticResource McHeaderText}"/>
                    <TextBlock x:Name="VersionText" FontSize="9.5" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                </Grid>
            </ContentControl>

            <TextBlock x:Name="StatusText" Grid.Row="1" Margin="1,0,0,8" FontSize="10.5" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"/>

            <Grid Grid.Row="2" Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{loc:Tr mods.search}" Style="{StaticResource McLabel}"
                           Margin="1,0,10,0" VerticalAlignment="Center"/>

                <TextBox x:Name="ModSearch" Grid.Column="1" Style="{StaticResource McTextBox}" Height="30"
                         TextChanged="Search_TextChanged"
                         ToolTip="{loc:Tr mods.search.tip}"/>

                <TextBlock x:Name="CountText" Grid.Column="2" Margin="10,0,1,0" FontSize="10.5"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
            </Grid>

            <ContentControl Grid.Row="3" Style="{StaticResource McScreen}">
                <ListView x:Name="ModList" Background="Transparent" BorderThickness="0"
                          Foreground="{DynamicResource ScreenText}" Padding="6"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Mod" Width="290" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="mod-id" Width="180" DisplayMemberBinding="{Binding ModId}"/>
                            <GridViewColumn Header="{loc:Tr mods.col.version}" Width="150" DisplayMemberBinding="{Binding Version}"/>
                            <GridViewColumn Header="{loc:Tr mods.col.recipes}" Width="90" DisplayMemberBinding="{Binding RecipesText}"/>
                            <GridViewColumn Header="Scripts" Width="80" DisplayMemberBinding="{Binding ScriptsText}"/>
                            <GridViewColumn Header="Jar" Width="210" DisplayMemberBinding="{Binding Jar}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </ContentControl>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="{loc:Tr mods.close}" Width="130" Height="34" IsCancel="True"
                        Style="{StaticResource McButtonSteel}"/>
            </StackPanel>
        </Grid>
    </ContentControl>
</Window>
