<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Minecraft "crafting terminal"-look: dikke bevels, donkere slots, monospace.
        De kleuren hieronder zijn de donkere standaard; ApplyTheme() in MainWindow
        overschrijft ze per thema (dezelfde keys).
    -->

    <!-- ===== Kleuren ===== -->
    <SolidColorBrush x:Key="WindowBg" Color="#0C1014"/>
    <SolidColorBrush x:Key="PanelFace" Color="#2B3138"/>
    <SolidColorBrush x:Key="PanelFaceAlt" Color="#22272D"/>
    <SolidColorBrush x:Key="BevelLight" Color="#59616B"/>
    <SolidColorBrush x:Key="BevelDark" Color="#14181C"/>
    <SolidColorBrush x:Key="Edge" Color="#05080B"/>
    <!-- Het hoekje tussen twee scrollbars pakt standaard de systeemkleur (fel wit). -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#22272D"/>
    <SolidColorBrush x:Key="SlotFace" Color="#12161A"/>
    <SolidColorBrush x:Key="ScreenBg" Color="#0A0D10"/>
    <SolidColorBrush x:Key="ScreenText" Color="#E6EDE2"/>
    <SolidColorBrush x:Key="ScreenDim" Color="#8C978F"/>
    <SolidColorBrush x:Key="SelectionBg" Color="#22402A"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#E4E9DD"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#98A2A8"/>
    <SolidColorBrush x:Key="Accent" Color="#9B7BD4"/>
    <SolidColorBrush x:Key="OnAccent" Color="#14101C"/>
    <SolidColorBrush x:Key="ButtonBg" Color="#46505B"/>
    <SolidColorBrush x:Key="ButtonText" Color="#F0F4F7"/>
    <SolidColorBrush x:Key="ButtonFace" Color="#3B444D"/>
    <SolidColorBrush x:Key="SuccessBg" Color="#4E8A46"/>
    <SolidColorBrush x:Key="SuccessText" Color="#F2FFEC"/>
    <SolidColorBrush x:Key="Highlight" Color="#F2C94C"/>
    <SolidColorBrush x:Key="WatchActive" Color="#86C46A"/>
    <SolidColorBrush x:Key="WatchInactive" Color="#77818B"/>

    <!-- ===== Tekststijlen ===== -->
    <Style x:Key="McLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="Margin" Value="1,0,0,4"/>
    </Style>

    <Style x:Key="McHeaderText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ===== Panelen ===== -->
    <Style x:Key="McPanel" TargetType="ContentControl">
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border Background="{DynamicResource Edge}"/>
                        <Grid Margin="2">
                            <Border Background="{DynamicResource PanelFace}"/>
                            <Border BorderThickness="2,2,0,0" BorderBrush="{DynamicResource BevelLight}"/>
                            <Border BorderThickness="0,0,2,2" BorderBrush="{DynamicResource BevelDark}"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" SnapsToDevicePixels="True"/>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ingezette sub-paneel (iets donkerder vlak) -->
    <Style x:Key="McPanelDeep" TargetType="ContentControl">
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border Background="{DynamicResource Edge}"/>
                        <Grid Margin="1">
                            <Border Background="{DynamicResource PanelFaceAlt}"/>
                            <Border BorderThickness="1,1,0,0" BorderBrush="{DynamicResource BevelDark}"/>
                            <Border BorderThickness="0,0,1,1" BorderBrush="{DynamicResource BevelLight}"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" SnapsToDevicePixels="True"/>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slot: diep ingezet vlak (invoervelden, icoonvakjes) -->
    <Style x:Key="McInset" TargetType="ContentControl">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border Background="{DynamicResource Edge}"/>
                        <Grid Margin="1">
                            <Border Background="{DynamicResource SlotFace}"/>
                            <Border BorderThickness="2,2,0,0" BorderBrush="{DynamicResource BevelDark}"/>
                            <Border BorderThickness="0,0,2,2" BorderBrush="{DynamicResource BevelLight}"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" SnapsToDevicePixels="True"/>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Scherm: waar de terminal-tekst in staat -->
    <Style x:Key="McScreen" TargetType="ContentControl">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border Background="{DynamicResource Edge}"/>
                        <Grid Margin="1">
                            <Border Background="{DynamicResource ScreenBg}"/>
                            <Border BorderThickness="2,2,0,0" BorderBrush="{DynamicResource BevelDark}"/>
                            <Border BorderThickness="0,0,2,2" BorderBrush="{DynamicResource BevelLight}"/>
                            <ContentPresenter SnapsToDevicePixels="True"/>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Titelstrip boven een paneel -->
    <Style x:Key="McHeader" TargetType="ContentControl">
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border Background="{DynamicResource Edge}"/>
                        <Grid Margin="1">
                            <Border Background="{DynamicResource PanelFaceAlt}"/>
                            <Border BorderThickness="0,0,0,2" BorderBrush="{DynamicResource BevelDark}"/>
                            <Border BorderThickness="1,1,0,0" BorderBrush="{DynamicResource BevelLight}"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" SnapsToDevicePixels="True"/>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Knoppen ===== -->
    <Style x:Key="McButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource ButtonFace}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonText}"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <Border Background="{DynamicResource Edge}"/>
                        <Grid Margin="1">
                            <Border x:Name="Face" Background="{TemplateBinding Background}"/>
                            <Border x:Name="TL" BorderThickness="2,2,0,0" BorderBrush="{DynamicResource BevelLight}"/>
                            <Border x:Name="BR" BorderThickness="0,0,2,2" BorderBrush="{DynamicResource BevelDark}"/>
                            <Border x:Name="Hover" Background="#FFFFFF" Opacity="0"/>
                            <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="0.13"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="0.22"/>
                            <Setter TargetName="TL" Property="BorderBrush" Value="{DynamicResource BevelDark}"/>
                            <Setter TargetName="BR" Property="BorderBrush" Value="{DynamicResource BevelLight}"/>
                            <Setter TargetName="Content" Property="Margin" Value="13,8,11,6"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="McButtonPrimary" TargetType="Button" BasedOn="{StaticResource McButton}">
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
    </Style>

    <Style x:Key="McButtonSuccess" TargetType="Button" BasedOn="{StaticResource McButton}">
        <Setter Property="Background" Value="{DynamicResource SuccessBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource SuccessText}"/>
    </Style>

    <Style x:Key="McButtonSteel" TargetType="Button" BasedOn="{StaticResource McButton}">
        <Setter Property="Background" Value="{DynamicResource ButtonBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonText}"/>
    </Style>

    <!-- Verticale tab in de rail -->
    <Style x:Key="McTab" TargetType="Button" BasedOn="{StaticResource McButton}">
        <Setter Property="Width" Value="64"/>
        <Setter Property="Height" Value="58"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="Padding" Value="2,4"/>
        <Setter Property="FontSize" Value="9.5"/>
        <Setter Property="Background" Value="{DynamicResource ButtonBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonText}"/>
    </Style>

    <!-- ===== Invoervelden ===== -->
    <Style x:Key="McTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource ScreenText}"/>
        <Setter Property="Background" Value="{DynamicResource SlotFace}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource ScreenText}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border Background="{DynamicResource Edge}"/>
                        <Grid Margin="1" Background="{TemplateBinding Background}">
                            <Border BorderThickness="2,2,0,0" BorderBrush="{DynamicResource BevelDark}"/>
                            <Border BorderThickness="0,0,2,2" BorderBrush="{DynamicResource BevelLight}"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="7,3"
                                          VerticalAlignment="Center" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Alleen-lezen tekst op een scherm (geen kader, geen scrollbars van zichzelf) -->
    <Style x:Key="McViewerText" TargetType="TextBox" BasedOn="{StaticResource McTextBox}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource ScreenText}"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                  Background="Transparent" Padding="0"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Hidden"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource ScreenText}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="McComboBox" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource ScreenText}"/>
        <Setter Property="Background" Value="{DynamicResource SlotFace}"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border Background="{DynamicResource Edge}"/>
                        <Grid Margin="1" Background="{TemplateBinding Background}">
                            <Border BorderThickness="2,2,0,0" BorderBrush="{DynamicResource BevelDark}"/>
                            <Border BorderThickness="0,0,2,2" BorderBrush="{DynamicResource BevelLight}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Margin="8,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>

                                <Grid Grid.Column="1" Margin="0,2,2,2">
                                    <Border Background="{DynamicResource ButtonFace}"/>
                                    <Border BorderThickness="2,2,0,0" BorderBrush="{DynamicResource BevelLight}"/>
                                    <Border BorderThickness="0,0,2,2" BorderBrush="{DynamicResource BevelDark}"/>
                                    <Path Data="M 0,0 L 4,4 L 8,0" Stroke="{DynamicResource ButtonText}" StrokeThickness="2"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>

                                <ToggleButton Grid.ColumnSpan="2" Focusable="False" ClickMode="Press"
                                              Background="Transparent" BorderThickness="0"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Grid>
                        </Grid>

                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False" PopupAnimation="None">                            <Border Background="{DynamicResource Edge}" Padding="1" Margin="0,2,0,0"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Grid Background="{DynamicResource SlotFace}">
                                    <Border BorderThickness="2,2,0,0" BorderBrush="{DynamicResource BevelDark}"/>
                                    <Border BorderThickness="0,0,2,2" BorderBrush="{DynamicResource BevelLight}"/>
                                    <ScrollViewer Margin="3" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Scrollbars ===== -->
    <Style x:Key="McScrollRepeat" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="McScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid>
                        <Border Background="{DynamicResource Edge}"/>
                        <Grid Margin="1">
                            <Border Background="{DynamicResource ButtonBg}"/>
                            <Border BorderThickness="1,1,0,0" BorderBrush="{DynamicResource BevelLight}"/>
                            <Border BorderThickness="0,0,1,1" BorderBrush="{DynamicResource BevelDark}"/>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Background" Value="{DynamicResource PanelFaceAlt}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource McScrollRepeat}" Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource McScrollThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource McScrollRepeat}" Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Width" Value="Auto"/>
                            <Setter Property="Height" Value="12"/>
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Boom ===== -->
    <Style x:Key="McTreeView" TargetType="TreeView">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource ScreenText}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
    </Style>

    <Style TargetType="TreeViewItem">
        <Setter Property="Foreground" Value="{DynamicResource ScreenText}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <StackPanel>
                        <Border x:Name="Row" Background="Transparent" Padding="2,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ToggleButton x:Name="Expander" Grid.Column="0" Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <TextBlock x:Name="Glyph" Text="▶" FontSize="9"
                                                       Foreground="{DynamicResource ScreenDim}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Glyph" Property="Text" Value="▼"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <ContentPresenter Grid.Column="1" ContentSource="Header" Margin="4,0,0,0"
                                                  VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                        <ItemsPresenter x:Name="ItemsHost" Margin="14,0,0,0"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectionBg}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="#14FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Lijst (instance-kiezer) ===== -->
    <Style TargetType="ListViewItem">
        <Setter Property="Foreground" Value="{DynamicResource ScreenText}"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <GridViewRowPresenter Content="{TemplateBinding Content}" Columns="{TemplateBinding GridView.ColumnCollection}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBg}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="GridViewColumnHeader">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Border Background="{DynamicResource PanelFaceAlt}" Padding="6,5"
                            BorderBrush="{DynamicResource BevelDark}" BorderThickness="0,0,0,1">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
