<Window x:Class="Mcrpv.ModScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Mcrpv"
        Title="{loc:Tr scan.title}" Height="560" Width="780"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" ShowInTaskbar="False">

    <ContentControl Style="{StaticResource McPanel}" Margin="14" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ContentControl Grid.Row="0" Style="{StaticResource McHeader}" Padding="10,5" Margin="0,0,0,8">
                <Grid>
                    <TextBlock Text="{loc:Tr scan.header}" Style="{StaticResource McHeaderText}"/>
                    <TextBlock x:Name="VersionText" FontSize="9.5" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                </Grid>
            </ContentControl>

            <TextBlock x:Name="InstanceText" Grid.Row="1" Margin="1,0,0,6" FontSize="10.5" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"/>

            <TextBlock Grid.Row="2" Margin="1,0,0,5" Style="{StaticResource McLabel}"
                       Text="{loc:Tr scan.scripts}"/>

            <ContentControl Grid.Row="3" Style="{StaticResource McScreen}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="FolderPanel" Margin="8,6"/>
                </ScrollViewer>
            </ContentControl>

            <TextBlock x:Name="ScanResultText" Grid.Row="4" Margin="1,8,0,0" FontSize="10.5" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Text="{loc:Tr scan.hint}"/>

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="ScanButton" Content="{loc:Tr scan.go}" Width="150" Height="34" Margin="0,0,8,0"
                        Style="{StaticResource McButtonPrimary}" Click="Scan_Click"
                        ToolTip="{loc:Tr scan.go.tip}"/>

                <Button x:Name="UseButton" Content="{loc:Tr scan.use}" Width="140" Height="34" Margin="0,0,8,0"
                        IsDefault="True" IsEnabled="False"
                        Style="{StaticResource McButtonSuccess}" Click="Use_Click"
                        ToolTip="{loc:Tr scan.use.tip}"/>

                <Button Content="{loc:Tr scan.close}" Width="130" Height="34" IsCancel="True"
                        Style="{StaticResource McButtonSteel}"/>
            </StackPanel>
        </Grid>
    </ContentControl>
</Window>
